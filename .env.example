# Required: PostgreSQL connection string.
DATABASE_URL=postgres://velk:velk@localhost:5432/velk
# Public address of the install. Optional: without it, the install screen detects the address and asks you to confirm it.
# When set, it always wins. Use the public https address when you take payments: it becomes the base of the
# payment webhook addresses and of the links in emails and payment pages.
APP_URL=
# Reserved for signing features. Generated automatically if unset.
SECRET_KEY=
# Directory for local files when S3 is not configured.
DATA_DIR=/data
# HTTP port the server listens on.
PORT=3000

# Optional S3-compatible storage endpoint (leave empty to store files in DATA_DIR).
S3_ENDPOINT=
# S3 region.
S3_REGION=
# S3 bucket name.
S3_BUCKET=
# S3 access key id.
S3_ACCESS_KEY_ID=
# S3 secret access key.
S3_SECRET_ACCESS_KEY=

# Optional SMTP server host (leave empty to disable outgoing email).
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# SMTP username.
SMTP_USER=
# SMTP password.
SMTP_PASS=
# Optional Resend API key: sends email over HTTPS instead of SMTP (for hosts that
# block outbound SMTP). When set, the SMTP variables above are ignored.
RESEND_API_KEY=
# Sender address used for outgoing email (needed with SMTP or Resend).
MAIL_FROM=

# Optional Stripe secret key for card payments.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Optional Mercado Pago access token.
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago webhook signing secret.
MERCADOPAGO_WEBHOOK_SECRET=

# Check for the latest release (true or false), at most every 12 hours, when the owner or a manager opens the panel.
UPDATE_CHECK=true
