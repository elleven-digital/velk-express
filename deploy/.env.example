# Copy to .env next to docker-compose.yml. Nothing here is required.

# Public domain served by Caddy (automatic HTTPS). Defaults to localhost.
DOMAIN=localhost
# Database password. Change me: the default "velk" is only fit for local tests.
# Must be URL-safe (letters and digits only): it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=velk
# Image to run. Pin a version for production.
VELK_IMAGE=ghcr.io/elleven-digital/velk-express:0

# Public base URL of the install, used in links and emails (e.g. https://painel.example.com).
APP_URL=
# Reserved for signing features. Generated automatically if unset.
SECRET_KEY=

# Optional S3-compatible storage (leave empty to store files in the velk-data volume).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional SMTP (leave empty to disable outgoing email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional payment providers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Check for the latest release (true or false), at most every 12 hours, when the owner or a manager opens the panel. Empty means true.
UPDATE_CHECK=
